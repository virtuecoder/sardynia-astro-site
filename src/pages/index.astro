---
// Layout component
import Layout from '../components/layout/Layout.astro';
import MapContainer from '../components/map/MapContainer.astro';
import DetailsPanel from '../components/details/DetailsPanel.astro';
---
<Layout title="Sardynia – Mapa z Dojazdem" description="Interaktywna mapa Sardynii z najpiękniejszymi atrakcjami">
  <div class="app">
    <MapContainer />
    <DetailsPanel />
  </div>
</Layout>

<script type="module">
  import { initializeMap } from '../scripts/map-client';
  // Delay to ensure CSS dimensions are applied before Leaflet init
  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', () => setTimeout(initializeMap, 200));
  } else {
    setTimeout(initializeMap, 200);
  }
</script>